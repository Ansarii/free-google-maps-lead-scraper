{
  "name": "Google Maps Lead Scraper to Cold Outreach Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger (Weekly)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/neon_innovation_lab~google-maps-b2b-lead-enricher/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.APIFY_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "searchQueries",
              "value": "[\"Roofers in Austin, TX\"]"
            },
            {
              "name": "maxResultsPerQuery",
              "value": "50"
            },
            {
              "name": "extractEmailsAndSocials",
              "value": "true"
            },
            {
              "name": "countryCode",
              "value": "us"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "2",
      "name": "Run Google Maps Scraper (Apify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.emails && $json.emails.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "3",
      "name": "Filter: Has Verified Email",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalize leads for Smartlead, Instantly, or HubSpot CRM\nreturn $input.all().map(item => {\n  const data = item.json;\n  return {\n    json: {\n      companyName: data.title,\n      category: data.category,\n      primaryEmail: (data.emails && data.emails[0]) ? data.emails[0] : '',\n      allEmails: (data.emails || []).join('; '),\n      phone: data.phone || '',\n      website: data.website || '',\n      address: data.address || '',\n      rating: data.rating || '',\n      reviewCount: data.reviewsCount || 0,\n      linkedinUrl: (data.socials && data.socials.linkedin) ? data.socials.linkedin : '',\n      mapsUrl: data.googleMapsUrl || '',\n      source: 'Google Maps Automated Enrichment'\n    }\n  };\n});"
      },
      "id": "4",
      "name": "Format Lead For CRM/Sequencer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger (Weekly)": {
      "main": [
        [
          {
            "node": "Run Google Maps Scraper (Apify)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Google Maps Scraper (Apify)": {
      "main": [
        [
          {
            "node": "Filter: Has Verified Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter: Has Verified Email": {
      "main": [
        [
          {
            "node": "Format Lead For CRM/Sequencer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
